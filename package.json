{
  "name": "fire-evac-nav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "시각장애인 실내 대피 AI 내비게이션 (MVP)",
  "workspaces": ["backend"],
  "scripts": {
    "dev": "npm run sync && node scripts/start-all.mjs",
    "dev:frontend": "node scripts/dev-server.mjs",
    "dev:backend": "node --watch backend/src/server.js",
    "sync": "node scripts/sync-shared.mjs",
    "start": "npm run sync && node backend/src/server.js",
    "test": "npm run sync && node test/route.test.mjs && node test/positioning.test.mjs && node test/plan-reader.test.mjs && node backend/test/api.test.mjs",
    "detector": "python -m uvicorn app:app --host 127.0.0.1 --port 8001 --app-dir ml/detector"
  },
  "engines": {
    "node": ">=20"
  }
}
