flowchart TB
  S(["앱 진입"]) --> P{"활성 도면 로드"}
  P -- "성공" --> B["비콘 스캔 시작"]
  P -- "실패(오프라인)" --> C["캐시 도면 사용<br/>배지: 오프라인"] --> B
  B --> L{"위치 확정?<br/>(locked)"}
  L -- "예" --> AN["aria-live 낭독<br/>'현재 위치는 301호 진료실 앞'"] --> ST["대피 시작 버튼 활성화"]
  L -- "아니오(비콘 실패)" --> FB["폴백: QR·목록 선택<br/>(details 접힘)"] --> ST
  ST --> R["POST /api/route {from, kind}"]
  R --> Q{"route?"}
  Q -- "경로 있음" --> GUIDE["구간 안내<br/>음성+진동 6개 명령"]
  Q -- "null (안전한 길 없음)" --> SAFE["안전상태 전환<br/>구조요청 자동 전송"]
  GUIDE --> H{"위험 변화?<br/>(SSE/3초 폴링)"}
  H -- "예" --> RE["재탐색 ≤2초<br/>KPI 기록"] --> GUIDE
  H -- "아니오" --> MV{"이동 갱신"}
  MV -- "이탈 → 확신도<40%" --> SAFE
  MV -- "출구 도착" --> DONE(["대피 완료<br/>보호자 알림"])
  MV -- "계속" --> GUIDE
  SAFE --> WAIT["'이동하지 말고 대기하세요'<br/>관제 SOS 카드 + 보호자 연락처"]
