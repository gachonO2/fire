rules_version = '2';

// 프론트엔드는 Firestore에 직접 접근하지 않는다. 모든 읽기·쓰기는 백엔드가
// firebase-admin(서비스 계정)으로 수행하며, Admin SDK는 이 규칙을 우회한다.
// 따라서 클라이언트 직접 접근은 전부 차단하는 것이 올바른 설정이다.
//
// 이 구조의 이점: 브라우저에 Firebase API 키·자격증명이 노출되지 않고,
// 위험 상태(hazards) 쓰기를 백엔드의 관제 인증으로만 통제할 수 있다.
// 잘못된 위험 정보 주입은 곧바로 오안내 → 인명위험으로 이어지기 때문이다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
