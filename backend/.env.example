# 도면 판독 (피난안내도 사진 → 그래프)
#
# 이 키가 없으면 촬영·등록은 되지만 그래프는 안 그려진다.
# 사진은 반드시 남으므로, 나중에 키를 넣고 편집기에서 다시 판독하면 된다.
ANTHROPIC_API_KEY=mr_universal_Ra2Mrky7PZZOZUqLeLTbrCv-jh44hpVs

PORT=8080

# Firebase 서비스 계정
# 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON 경로
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# 관제 API 쓰기 보호용 토큰 (설정 시 hazards 변경에 x-admin-token 헤더 필요)
ADMIN_TOKEN=

# 피난안내도 사진 판독용 (console.anthropic.com 에서 발급)
# 비워두면 "AI로 읽기" 버튼만 꺼지고, 손으로 그리기는 그대로 됩니다.
ANTHROPIC_API_KEY=
PLAN_READER_MODEL=claude-opus-5

# ── Google AI Studio 직접 연결 (권장) ─────────────────────────────
# aistudio.google.com/apikey 에서 무료 발급. 게이트웨이를 안 거치므로
# 이미지가 확실히 전달된다. 이 값이 있으면 위 ANTHROPIC_* 보다 우선한다.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ── 도면 기호 탐지기 (ml/detector) ────────────────────────────────
# 피난안내도로 직접 학습시킨 YOLO 모델. 비상구·계단·실 위치를 상자로 집어낸다.
# 안 떠 있으면 판독이 언어모델 단독으로 내려갈 뿐, 도면 등록은 그대로 된다.
#   실행: cd ml/detector && uvicorn app:app --port 8001
DETECTOR_URL=http://127.0.0.1:8001
# 이보다 확신이 낮은 탐지는 버린다 (탐지기 쪽 DETECT_CONF 뒤에 걸리는 2차 문턱)
DETECTOR_MIN_CONFIDENCE=0.3
# 선택 — 기본값 그대로 두어도 된다
# PLAN_READER_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
